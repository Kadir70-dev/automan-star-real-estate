# Copy to .env.production and chmod 600. Never commit actual secrets.
# PostgreSQL password MUST be URL-safe because it is inserted into DATABASE_URL.
# openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
# Exact public frontend origins (not Hostinger or API URL):
ALLOWED_ORIGINS=https://automanstarrealty.com,https://www.automanstarrealty.com
# Choose unused host-only port. Do not expose publicly.
AUTOMAN_API_LOOPBACK_PORT=18080
# Shared with Netlify BACKEND_PROXY_SECRET so per-visitor lead/login rate limits work behind the relay.
# openssl rand -hex 32
TRUSTED_PROXY_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
